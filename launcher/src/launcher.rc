// Windows resources of warriors-launcher.exe: the port's original Wonder Wheel icon, the same as
// TheWarriors.exe (drawn by tools/icon/make_icon.py), and the version (0.1.9.1, as the Makefiles'
// RELEASE_VERSION; see runtime/src/thewarriors.rc).
#define VER_NUM 0,1,9,1
#define VER_STR "0.1.9.1"

1 ICON "../../assets/icon/wonder-wheel.ico"

1 VERSIONINFO
FILEVERSION VER_NUM
PRODUCTVERSION VER_NUM
FILEFLAGSMASK 0x3F
FILEFLAGS 0
FILEOS 0x40004      // VOS_NT_WINDOWS32
FILETYPE 1          // VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WarriorsReborn"
            VALUE "LegalCopyright", "Copyright 2026 WarriorsReborn"
            VALUE "FileDescription", "WarriorsReborn launcher"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "warriors-launcher"
            VALUE "OriginalFilename", "warriors-launcher.exe"
            VALUE "ProductName", "WarriorsReborn"
            VALUE "ProductVersion", VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
