--- a/core/src/core/CMakeLists.txt
+++ b/core/src/core/CMakeLists.txt
@@ -467,7 +467,7 @@ endif()
 
 if (IPL_OS_WINDOWS)
     target_sources(core PRIVATE
-        ${CMAKE_CURRENT_BINARY_DIR}/phonon.rc
+        # phonon.rc dropped (feasibility build)
     )
 endif()
 
@@ -675,7 +675,7 @@ if (IPL_OS_MACOS)
 endif()
 
 if (IPL_OS_LINUX)
-    target_link_options(phonon PRIVATE -Wl,--exclude-libs,ALL)
+    # removed for zig ld: -Wl,--exclude-libs,ALL
 endif()
 
 if (IPL_OS_WINDOWS AND IPL_CPU_X64 AND BUILD_SHARED_LIBS)
diff --git a/core/src/core/array_math.cpp b/core/src/core/array_math.cpp
index 58a2352..ebd42db 100644
