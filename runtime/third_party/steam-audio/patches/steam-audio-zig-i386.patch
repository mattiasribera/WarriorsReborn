Steam Audio v4.8.1 changes for the zig (clang) i386 build of WarriorsReborn (Apache 2.0 sec. 4b: these
files were modified). MSVC-only flags under if (MSVC); no -march=native / -m32 / -fabi-version / --exclude-libs;
no phonon.rc (zig has no windres); <delayimp.h> comes from pch.h; a GetProcAddress cast; the MSVC __m128
operator overloads only for MSVC; and a fix for an upstream bug: ArrayMath::multiplyAccumulate loads its
accumulator with an aligned SSE load even on the unaligned path (a segfault in convolution on i386).

diff --git a/core/CMakeLists.txt b/core/CMakeLists.txt
index 9553e7f..7bf2f05 100644
--- a/core/CMakeLists.txt
+++ b/core/CMakeLists.txt
@@ -135,6 +135,7 @@ if (IPL_OS_WINDOWS)
         _DISABLE_EXTENDED_ALIGNED_STORAGE
         $<IF:$<CONFIG:Debug>,_DEBUG,NDEBUG>
     )
+    if (MSVC) # zig feasibility patch
     add_compile_options(
         /EHsc /MP /W3 /Zi
         $<$<AND:$<CONFIG:Debug>,$<BOOL:${STEAMAUDIO_STATIC_RUNTIME}>>:/MTd>
@@ -154,16 +155,17 @@ if (IPL_OS_WINDOWS)
         $<IF:$<CONFIG:Release>,/INCREMENTAL:NO,/INCREMENTAL>
         $<$<CONFIG:Debug>:/NODEFAULTLIB:LIBCMT>
     )
+    endif() # zig feasibility patch
 endif()
 
 # Linux flags
 if (IPL_OS_LINUX)
     add_compile_options(-fPIC -g -fvisibility=hidden -Wl,--no-undefined)
     if (IPL_CPU_X86)
-        add_compile_options(-m32 -mfpmath=sse -march=native)
+        add_compile_options(-mfpmath=sse -msse2)
     endif()
     if (STEAMAUDIO_ENABLE_AVX)
-        add_compile_options(-fabi-version=6)
+        # removed for clang: -fabi-version=6
     endif()
 endif()
 
diff --git a/core/src/core/CMakeLists.txt b/core/src/core/CMakeLists.txt
