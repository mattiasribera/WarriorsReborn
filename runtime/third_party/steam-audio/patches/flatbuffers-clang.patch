FlatBuffers 1.12 header fix for clang 19+ (as upstream did later): the private copy assignment of
TableKeyComparator assigned a reference member; it is deleted instead (Apache 2.0 sec. 4b: modified file).

diff --git a/include/flatbuffers/flatbuffers.h b/include/flatbuffers/flatbuffers.h
index c4dc5bc..87dc04a 100644
--- a/include/flatbuffers/flatbuffers.h
+++ b/include/flatbuffers/flatbuffers.h
@@ -1871,10 +1871,7 @@ class FlatBufferBuilder {
     vector_downward &buf_;
 
    private:
-    TableKeyComparator &operator=(const TableKeyComparator &other) {
-      buf_ = other.buf_;
-      return *this;
-    }
+    TableKeyComparator &operator=(const TableKeyComparator &other) = delete;
   };
   /// @endcond
 
