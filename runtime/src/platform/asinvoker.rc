// Resources of the Windows build: the asInvoker manifest and the version information.
// The version constants mirror RELEASE_VERSION of the Makefiles (0.1.9.1, tag v0.1.9.1).
#define VER_NUM 0,1,9,1
#define VER_STR "0.1.9.1"

// Application manifest (RT_MANIFEST 24, CREATEPROCESS_MANIFEST_RESOURCE_ID 1) for the .exe files.
1 24 "asinvoker.manifest"

1 VERSIONINFO
FILEVERSION VER_NUM
PRODUCTVERSION VER_NUM
FILEFLAGSMASK 0x3F
FILEFLAGS 0
FILEOS 0x40004      // VOS_NT_WINDOWS32
FILETYPE 1          // VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WarriorsReborn"
            VALUE "LegalCopyright", "Copyright 2026 WarriorsReborn"
            VALUE "FileDescription", "WarriorsReborn loader"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "xbrun"
            VALUE "OriginalFilename", "TheWarriors.exe"
            VALUE "ProductName", "WarriorsReborn"
            VALUE "ProductVersion", VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
