// Resources of TheWarriors.exe (the Windows loader): the asInvoker / PerMonitorV2 manifest,
// the application icon (the original Wonder Wheel, assets/icon, drawn by tools/icon/make_icon.py)
// and the version.
#define VER_NUM 0,1,2,0
#define VER_STR "0.1.2"

1 24 "platform/asinvoker.manifest"
1 ICON "../../assets/icon/wonder-wheel.ico"

1 VERSIONINFO
FILEVERSION VER_NUM
PRODUCTVERSION VER_NUM
FILEFLAGSMASK 0x3F
FILEFLAGS 0
FILEOS 0x40004      // VOS_NT_WINDOWS32
FILETYPE 1          // VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "The Warriors"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "TheWarriors"
            VALUE "OriginalFilename", "TheWarriors.exe"
            VALUE "ProductName", "The Warriors PC Port"
            VALUE "ProductVersion", VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
