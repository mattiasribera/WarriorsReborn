#version 450
// --ssao-mode gtao under --taa, between the main pass and the one
// denoise pass: the main pass's visibility (its noise rotated every frame) accumulated over frames
// at the working size, so the AO term reaches the TAA resolve already settled. The resolve alone
// does not average it: its variance clip follows the frame where the surface is flat (AO-only
// regions of one colour), so the rotating noise and the jitter's shift of the working texels
// showed as crawling. Per working texel: its view position (the main pass's view depth), the
// frame's reprojection (renderer_taa: current clip -> previous clip) gives its texel in the
// previous frame's history; the history is read there bilinearly, only from texels on the same
// surface (view depth within pc.misc.z of the reprojected one: disocclusion takes the frame as
// is), clamped to the 3 x 3 neighbourhood's range on this surface and blended with pc.misc.x of
// the frame (plus pc.misc.w per working texel moved beyond the first, up to 0.5). Writes
// (visibility, packed edges, view depth) as the main pass: the denoise pass and the next frame's
// history read it.
// Not part of XeGTAO (whose sample relies on the renderer's TAA); MIT notice in gtao_common.glsl
// applies to the files derived from it.
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform PC {
    vec4 rx, ry, rw;   // the reprojection rows (previous clip x, y, w) of (ndc x * w, ndc y * w, w, 1)
    vec4 scr;          // working texel -> [0, 1] screen (y down): mul.xy, add.xy, as gtao_common.glsl
    vec4 size;         // working width, height, -, -
    vec4 misc;         // share of the frame, 1 = the history is usable, depth tolerance (relative), share per texel moved
} pc;
layout(set = 0, binding = 0) uniform sampler2D cur_in;   // the main pass's output (point sampled)
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D work_out;
layout(set = 0, binding = 6) uniform sampler2D hist_in;  // the previous frame's output of this pass
const float GTAO_FAR = 65000.0;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 last = ivec2(pc.size.xy) - 1;
    if (any(greaterThan(p, last))) return;
    vec4 c = texelFetch(cur_in, p, 0);
    float z = c.b;
    if (z >= GTAO_FAR || pc.misc.y < 0.5) {
        imageStore(work_out, p, c);
        return;
    }
    float tol = pc.misc.z;
    float lo = c.r, hi = c.r;
    for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++) {
            vec4 n = texelFetch(cur_in, clamp(p + ivec2(i, j), ivec2(0), last), 0);
            if (abs(n.b - z) <= tol * z) {
                lo = min(lo, n.r);
                hi = max(hi, n.r);
            }
        }
    vec2 s = vec2(p) * pc.scr.xy + pc.scr.zw;
    vec4 v = vec4(vec2(2.0 * s.x - 1.0, 1.0 - 2.0 * s.y) * z, z, 1.0);
    vec3 q = vec3(dot(pc.rx, v), dot(pc.ry, v), dot(pc.rw, v));
    if (!(q.z > 0.0)) {
        imageStore(work_out, p, c);
        return;
    }
    vec2 ps = vec2(q.x / q.z + 1.0, 1.0 - q.y / q.z) * 0.5;
    vec2 t = (ps - pc.scr.zw) / pc.scr.xy;
    if (any(lessThan(t, vec2(-0.5))) || any(greaterThan(t, vec2(last) + 0.5))) {
        imageStore(work_out, p, c);
        return;
    }
    ivec2 t0 = ivec2(floor(t));
    vec2 f = t - vec2(t0);
    float sum = 0.0, wsum = 0.0;
    for (int j = 0; j < 2; j++)
        for (int i = 0; i < 2; i++) {
            vec4 h = texelFetch(hist_in, clamp(t0 + ivec2(i, j), ivec2(0), last), 0);
            float w = (i == 1 ? f.x : 1.0 - f.x) * (j == 1 ? f.y : 1.0 - f.y);
            if (abs(h.b - q.z) <= tol * q.z) {
                sum += h.r * w;
                wsum += w;
            }
        }
    if (wsum < 0.05) {   // not seen there in the previous frame (disocclusion)
        imageStore(work_out, p, c);
        return;
    }
    float hv = clamp(sum / wsum, lo, hi);
    float k = clamp(pc.misc.x + pc.misc.w * max(length(t - vec2(p)) - 1.0, 0.0), pc.misc.x, 0.5);
    imageStore(work_out, p, vec4(mix(hv, c.r, k), c.g, z, 0.0));
}
