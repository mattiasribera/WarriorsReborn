; Collision patch (docs/MODDING.md "Collision patches"): the caged room under the hideout's main floor,
; where the sparring spot is, gets a floor, walls along its chain-link fence and a ceiling, so the player
; can walk in through the door frame in its north fence (from the corridor behind the main floor) and out
; again. The same room as 20-hideout-trophies' cage.col (without its trophy counter), so the ring works
; with or without that mod; with both on, the shapes are simply there twice.
level = level95

material = 5   ; concrete, as the walkway
floor -174.84 81.70 -165.16 98.80 -197.575

material = 31  ; the fence's own material
wall -174.84 81.70 -174.84 98.80 -197.60 -194.45   ; west
wall -174.84 81.70 -165.16 81.70 -197.60 -194.45   ; south
wall -165.16 81.70 -165.16 98.80 -197.60 -194.45   ; east (the walkway side)
wall -174.84 98.80 -171.20 98.80 -197.60 -194.45   ; north, west of the door
wall -169.65 98.80 -165.16 98.80 -197.60 -194.45   ; north, east of the door
wall -171.20 98.80 -169.65 98.80 -195.40 -194.45   ; above the door
ceiling -174.84 81.70 -165.16 98.80 -194.45

; the level's own fence along the north side (one-sided, facing the corridor) spans the doorway
remove -173.40 98.75 -197.60 -167.00 98.86 -194.85

material = 7   ; the wooden posts inside the cage
box -172.46 98.09 -197.60 -172.26 98.29 -194.45
box -172.46 83.02 -197.60 -172.26 83.22 -194.45
box -165.90 98.09 -197.60 -165.70 98.29 -194.45
box -165.90 90.95 -197.60 -165.70 91.15 -194.45
box -165.90 83.02 -197.60 -165.70 83.22 -194.45
